{
  "name": "hono-overlay",
  "version": "0.1.0",
  "description": "Temporarily overlay routes on a Hono app and detach them to restore the originals.",
  "keywords": [
    "hono",
    "mock",
    "overlay",
    "testing"
  ],
  "homepage": "https://github.com/ssssota/hono-overlay#readme",
  "bugs": {
    "url": "https://github.com/ssssota/hono-overlay/issues"
  },
  "license": "MIT",
  "author": "TOMIKAWA Sotaro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ssssota/hono-overlay.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.mjs",
  "types": "dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown --dts src/index.ts",
    "fmt": "oxfmt && oxlint --fix",
    "lint": "oxfmt --check && oxlint",
    "check": "tsc -b",
    "test": "vitest run"
  },
  "devDependencies": {
    "hono": "^4.13.5",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "hono": ">=4.0.0"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
